<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ラピッド圧縮✧展開" Manufacturer="YuzukoUnderson" Version="1.0.0.0" UpgradeCode="a6b856b3-6c8c-4a37-b452-e56bdc39e9f6" Scope="perMachine" Codepage="65001">
    
    <MajorUpgrade DowngradeErrorMessage="既に新しいバージョンがインストールされています。" />

    <!-- アプリケーションのアイコンやMSIのキャビネット埋め込みなどを設定 -->
    <MediaTemplate EmbedCab="yes" />

    <!-- UIの設定 (ウィザードUIの有効化) -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ディレクトリ構成の定義 -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RapidZipper" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ラピッド圧縮✧展開" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- インストールするファイルの定義 -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3b9e4a38-c67d-4171-8bc6-9464e8e815ad">
        <!-- シングルファイルパブリッシュされた実行ファイルをインストール -->
        <File Id="RapidZipperExe" Source="bin\Release\net10.0-windows\win-x64\publish\rapid-zipper.exe" KeyPath="yes" />
        
        <!-- スタートメニューへのショートカット -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="ラピッド圧縮✧展開"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />

        <!-- デスクトップへのショートカット -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="ラピッド圧縮✧展開"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />
      </Component>

      <!-- 右クリックメニュー（コンテキストメニュー）登録用コンポーネント -->
      <Component Id="ContextMenuAssociation" Guid="2fdfb8f2-3904-4b5f-a36c-2f96cfb2f707">
        <!-- ファイルの右クリックメニュー -->
        <RegistryKey Root="HKMU" Key="Software\Classes\*\shell\RapidZipper">
          <RegistryValue Value="ラピッド圧縮✧展開で処理 / Process with RapidZipper" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]rapid-zipper.exe,0" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]rapid-zipper.exe&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>
        
        <!-- フォルダの右クリックメニュー -->
        <RegistryKey Root="HKMU" Key="Software\Classes\Directory\shell\RapidZipper">
          <RegistryValue Value="ラピッド圧縮✧展開で処理 / Process with RapidZipper" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]rapid-zipper.exe,0" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]rapid-zipper.exe&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>

        <!-- フォルダ内背景の右クリックメニュー -->
        <RegistryKey Root="HKMU" Key="Software\Classes\Directory\Background\shell\RapidZipper">
          <RegistryValue Value="ラピッド圧縮✧展開で処理 / Process with RapidZipper" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]rapid-zipper.exe,0" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]rapid-zipper.exe&quot; &quot;%V&quot;" Type="string" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- スタートメニューフォルダのクリーンアップ用コンポーネント -->
    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="CleanupShortcuts" Guid="1d1134a6-7d61-46ab-a5a4-22b62ea8360d">
        <RegistryValue Root="HKCU" Key="Software\YuzukoUnderson\RapidZipper" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- インストール完了画面の「起動する」チェックボックスと起動カスタムアクションの設定 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RapidZipper / ラピッド圧縮✧展開を起動する" />
    <Property Id="WixShellExecTarget" Value="[#RapidZipperExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- インストール機能の定義 -->
    <Feature Id="MainFeature">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>
</Wix>
